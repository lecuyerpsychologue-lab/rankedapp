{
  "expo": {
    "name": "RANKED",
    "slug": "rankedapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050507"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rankedapp.ios",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow RANKED to access your photos to upload a profile picture.",
        "NSCameraUsageDescription": "Allow RANKED to use your camera to take a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050507"
      },
      "package": "com.rankedapp.android"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": false
          },
          "android": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "scheme": "rankedapp",
    "experiments": {
      "typedRoutes": true
    }
  }
}
